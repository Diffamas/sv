# COTOMA — tableau de bord privé (OVH, Apache)
RewriteEngine On
# Redirection HTTPS : réactivée par Claude dès que le certificat cotoma.fr est émis par OVH.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Jamais d'accès direct à la base, aux sauvegardes ni à la configuration
RewriteRule ^data(/|$) - [F]
<FilesMatch "^(config\.php|.*\.sqlite.*|.*\.json|build\.py)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
AddType font/woff2 .woff2
AddDefaultCharset UTF-8
DirectoryIndex index.html
